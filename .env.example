# Environment is read once at startup. No .env file is loaded automatically.
# Copy this file outside Git, fill required values, and export it in your shell.
# All paths for credentials must be absolute, private regular files (0600).

# Optional; default 127.0.0.1:8080; non-secret. Public/wildcard IPs require DOMAIN.
IPA_NOW_LISTEN=127.0.0.1:8080
# Optional; no default; non-secret. External HTTPS hostname (optional explicit port).
# Setting this makes it the only accepted Host and Origin and permits a public/wildcard
# listen IP for a reverse proxy. The proxy must provide TLS, authentication, and limits.
IPA_NOW_DOMAIN=
# Optional; default ./data; non-secret. Dedicated directory, mode 0700.
# Includes durable device-journal/ and SQLite attempt ownership; back up together.
IPA_NOW_DATA_DIR=./data
# Required; no default; private device hostname/IP (operator-sensitive, never logged).
IPA_NOW_DEVICE_HOST=
# Optional; default 22; non-secret. Range 1–65535.
IPA_NOW_DEVICE_PORT=22
# Optional; default mobile; non-secret.
IPA_NOW_DEVICE_USER=mobile
# Optional; no default; SECRET. RemoteCompanion device unlock PIN, preserved as
# a string (including leading zeros). Passed to `rc unlock` as a process argument.
IPA_NOW_DEVICE_UNLOCK_PIN=
# Optional; default key; non-secret. Either key or password.
IPA_NOW_SSH_AUTH=key
# Required for key auth; no default; sensitive filesystem path, never sent to browser.
IPA_NOW_SSH_KEY_PATH=
# Optional; no default; SECRET. Encrypted SSH key passphrase.
IPA_NOW_SSH_KEY_PASSPHRASE=
# Required for password auth; optional sudo password for key auth; no default; SECRET.
IPA_NOW_SSH_PASSWORD=
# Required; no default; sensitive path to dedicated, manually verified known_hosts.
# Enrollment is manual and explicit; the app never accepts new or changed keys.
IPA_NOW_KNOWN_HOSTS_PATH=
# Optional; no default; private account identifier. Required for App Store requests.
IPA_NOW_APPLE_EMAIL=
# Optional for valid saved sessions; required for initial login/token refresh; SECRET.
IPA_NOW_APPLE_PASSWORD=
# Optional; default host-detected; private account identifier. Stable six-byte MAC
# used for App Store login, purchase, and download (for example 02:00:00:00:00:01).
IPA_NOW_APPLE_MAC_ADDRESS=
# Optional; default 30m; non-secret. 1s–24h. Execution/retry budget; cleanup uses separate bounded contexts.
IPA_NOW_JOB_TIMEOUT=30m
# Optional; default 24h; non-secret. 1m–8760h. Includes cleanup-review waiting time.
IPA_NOW_ARTIFACT_RETENTION=24h
# Optional; default 2147483648 (2 GiB); non-secret. 1 byte–8 GiB.
IPA_NOW_MAX_UPLOAD_BYTES=2147483648
# Optional; default 20; non-secret. Queued + running + cleanup-review jobs, 1–1000.
IPA_NOW_QUEUE_LIMIT=20
# Optional; default 3; non-secret. 1–5 attempts; only safe connection failures retry.
IPA_NOW_MAX_ATTEMPTS=3
# Optional; default info; non-secret. debug, info, warn, or error. Logs go to
# stderr only. debug adds per-phase engine progress and successful API reads;
# failure details (redacted library error causes) are logged at error level.
IPA_NOW_LOG_LEVEL=info
# Optional; default text; non-secret. text or json (json suits log collectors).
IPA_NOW_LOG_FORMAT=text
# Integration-test-only; required for make test-device; no default; non-secret.
# Must name an app already installed on the configured device.
# IPA_NOW_INTEGRATION_TARGET=com.example.app
